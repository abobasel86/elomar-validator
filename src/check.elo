// validator: checks for user input, such as web forms.
use std.regex

// A plausible e-mail address: text@domain.tld, no spaces.
pub fn email(s: String) -> Bool {
    return s.length <= 254 && regex.is_match(r"^[^\s@]+@[^\s@]+\.[^\s@.]+$", s)
}

// An http or https address with a host.
pub fn url(s: String) -> Bool {
    return regex.is_match(r"^https?://[^\s/?#.][^\s/?#]*(\.[^\s/?#]+)*(:[0-9]+)?([/?#]\S*)?$", s)
}

// A phone number: an optional "+" and 7 to 15 digits. Spaces, dashes,
// dots and parentheses are allowed between digits.
pub fn phone(s: String) -> Bool {
    let compact = regex.replace(r"[\s\-.()]", s.trim(), "")
    return regex.is_match(r"^\+?[0-9]{7,15}$", compact)
}

// Only the digits 0-9 (at least one).
pub fn digits(s: String) -> Bool {
    return regex.is_match(r"^[0-9]+$", s)
}

// Between `min` and `max` letters, counting what you see.
pub fn length_between(s: String, min: Int, max: Int) -> Bool {
    return s.length >= min && s.length <= max
}

pub fn between(n: Int, min: Int, max: Int) -> Bool {
    return n >= min && n <= max
}

// At least 8 letters with a lower-case letter, an upper-case letter and a
// digit.
pub fn strong_password(s: String) -> Bool {
    return s.length >= 8
    && regex.is_match(r"\p{Ll}", s)
    && regex.is_match(r"\p{Lu}", s)
    && regex.is_match(r"[0-9]", s)
}

// A date written as YYYY-MM-DD that exists in the calendar.
pub fn iso_date(s: String) -> Bool {
    if !regex.is_match(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$", s) {
        return false
    }
    let parts = s.split("-").map(|p| p.parse_int().unwrap_or(0))
    let year = parts[0]
    let month = parts[1]
    let day = parts[2]
    if month < 1 || month > 12 || day < 1 {
        return false
    }
    return day <= days_in_month(year, month)
}

fn days_in_month(year: Int, month: Int) -> Int {
    if month == 2 {
        let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
        return match leap {
            true => 29
            false => 28
        }
    }
    return match [4, 6, 9, 11].contains(month) {
        true => 30
        false => 31
    }
}

// `None` when `ok`, else `Some(message)`. Use with `collect`.
pub fn require(ok: Bool, message: String) -> Option<String> {
    return match ok {
        true => None
        false => Some(message)
    }
}

// The messages of the rules that failed, in order.
pub fn collect(rules: List<Option<String>>) -> List<String> {
    var out: List<String> = []
    for r in rules {
        match r {
            Some(m) => out.push(m)
            None => {}
        }
    }
    return out
}
